# Shopify Admin > Settings > Domains
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin > Sales channels > Headless > Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Use the stable Storefront API version enabled for your store.
SHOPIFY_API_VERSION=2026-07

# Handle of the Shopify blog the newsletter app publishes free preview
# editions to (the "Transmissions" section reads this blog).
NEWSLETTER_BLOG_HANDLE=news
